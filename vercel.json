{
  "version": 2,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "app.js", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/proxy", "dest": "/api/proxy.js" },
    { "src": "/api/ia", "dest": "/api/ia.js" },
    { "src": "/api/owner-check", "dest": "/api/owner-check.js" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
